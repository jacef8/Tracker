default_platform(:ios)

APP_IDENTIFIER = "com.groundlink.gimbalcam".freeze

# Same shape as native-app/ios/App/fastlane/Fastfile (GroundLink): API-key auth, a fresh
# App Store profile from sigh every run, upload only.
platform :ios do
  desc "Build Gimbal Cam and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"], # base64-encoded .p8 contents
      is_key_content_base64: true,
      in_house: false
    )

    increment_build_number(
      xcodeproj: "GimbalCam.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H")
    )

    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    update_code_signing_settings(
      path: "GimbalCam.xcodeproj",
      use_automatic_signing: false,
      team_id: "XM3MLRA366",
      targets: ["GimbalCam"],
      build_configurations: ["Release"],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      project: "GimbalCam.xcodeproj",
      scheme: "GimbalCam",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
