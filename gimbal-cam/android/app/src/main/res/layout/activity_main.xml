<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top: recording status and zoom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="READY"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="1.0×"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Last gimbal / Bluetooth key the app saw, so it's obvious the gimbal is talking to us -->
    <TextView
        android:id="@+id/lastKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="28dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/buttonsBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/round_button"
            android:contentDescription="Gimbal buttons"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <Space
            android:layout_width="28dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/recordBtn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/record_ring"
            android:contentDescription="Record">

            <View
                android:id="@+id/recordInner"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_gravity="center"
                android:background="@drawable/record_dot" />

            <TextView
                android:id="@+id/recordGlyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <Space
            android:layout_width="28dp"
            android:layout_height="1dp" />

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <TextView
                android:id="@+id/flipBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_button"
                android:contentDescription="Flip camera"
                android:gravity="center"
                android:text="⟲"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <!-- Shown in place of Flip while a recording is open (recording or paused) -->
            <FrameLayout
                android:id="@+id/stopBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/round_button"
                android:contentDescription="Stop and save"
                android:visibility="gone">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/record_square" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Gimbal button setup panel -->
    <ScrollView
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gimbal buttons"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pair the gimbal with the phone over Bluetooth (not only in DJI Mimo). To teach a control, tap Learn next to it, then press or roll that control on the gimbal."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/setupLastKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pill"
                android:padding="10dp"
                android:text="Waiting for a gimbal button…"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/actionRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hold the record button about a second to stop and save. Long-press Learn to forget what an action learned."
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Input log (newest first)"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eventLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/pill"
                android:fontFamily="monospace"
                android:minLines="4"
                android:padding="10dp"
                android:textColor="#DDFFFFFF"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/copyLogBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Copy log" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resetBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reset" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/doneBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Done" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
