{
  "rules": {
    "gl": {
      "_devices": {
        ".write": true,
        "$id": {
          "sched": {
            ".read": true
          },
          "ownerName": {
            ".read": true
          }
        },
        ".read": "auth != null"
      },
      "_deviceShares": {
        ".write": true,
        ".read": "auth != null"
      },
      "_debug": {
        ".write": true,
        ".read": "auth != null"
      },
      "_diag": {
        "devices": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null"
      },
      "_activityLog": {
        "$day": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null"
      },
      "_deviceOwners": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_deviceSharedWithMe": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_devOwner": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_voipSubs": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_avatars": {
        "$acct": {
          ".write": "auth != null && auth.uid === $acct"
        },
        ".read": "auth != null"
      },
      "_pttSubs": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_aclMiss": {
        "$room": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        ".read": "auth != null"
      },
      "_roomIndex": {
        "$room": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_directory": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_invites": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_presence": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_sessions": {
        ".write": "auth != null && !newData.exists()",
        "$sid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_users": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_deadRooms": {
        ".read": "auth != null",
        ".write": "false"
      },
      "$room": {
        ".write": "auth != null && !newData.exists() && (data.child('config').child('owner').val() === auth.uid || (!data.child('users').exists() && !data.child('members').exists() && !data.child('acl').exists() && !data.child('pins').exists() && !data.child('chat').exists() && !data.child('trails').exists()))",
        "users": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
          }
        },
        "acl": {
          "$uid": {
            ".write": "auth != null && (root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists() || (auth.uid === $uid && !newData.exists()))"
          }
        },
        "joinReq": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists())"
          },
          ".read": "auth != null && (root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists())"
        },
        "diag": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "favSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "history": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "pushSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "trails": {
          ".write": "auth != null && !newData.exists()",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "voice": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "chat": {
          ".write": "auth != null"
        },
        "closed": {
          ".write": "auth != null"
        },
        "config": {
          ".write": "auth != null"
        },
        "debug": {
          ".write": "auth != null"
        },
        "ownerRequest": {
          ".write": "auth != null"
        },
        "pins": {
          ".write": "auth != null"
        },
        "placeEvents": {
          ".write": "auth != null"
        },
        "places": {
          ".write": "auth != null"
        },
        "voiceAll": {
          ".write": "auth != null"
        },
        "voicelog": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      }
    },
    "gltest": {
      ".read": "auth != null",
      "$group": {
        "users": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "glh": {
          ".read": "auth != null",
          "$room": {
            ".write": "auth != null && !newData.exists()",
            "$uid": {
              ".write": "auth != null"
            }
          }
        },
        "$other": {
          ".write": true
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "_forceReload": {
      ".read": true,
      ".write": "auth != null"
    },
    "_forceRestart": {
      ".read": true,
      ".write": "auth != null"
    },
    "_minNative": {
      ".read": true,
      ".write": "auth != null"
    },
    "glh": {
      ".read": "auth != null",
      "$room": {
        "$uid": {
          ".write": "auth != null"
        }
      }
    }
  }
}
