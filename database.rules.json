{
  "rules": {
    "gl": {
      "_devices": {
        ".write": true,
        "$id": {
          "sched": {
            ".read": true
          },
          "ownerName": {
            ".read": true
          }
        },
        ".read": "auth != null"
      },
      "_deviceShares": {
        ".write": true,
        ".read": "auth != null"
      },
      "_debug": {
        ".write": true,
        ".read": "auth != null"
      },
      "_diag": {
        "devices": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null"
      },
      "_activityLog": {
        "$day": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null"
      },
      "_deviceOwners": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_deviceSharedWithMe": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_devOwner": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_directory": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_invites": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_presence": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_sessions": {
        ".write": "auth != null && !newData.exists()",
        "$sid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_users": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "$room": {
        ".write": "auth != null && !newData.exists()",
        "users": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
          }
        },
        "diag": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "favSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "history": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "pushSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "trails": {
          ".write": "auth != null && !newData.exists()",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "voice": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "chat": {
          ".write": "auth != null"
        },
        "closed": {
          ".write": "auth != null"
        },
        "config": {
          ".write": "auth != null"
        },
        "debug": {
          ".write": "auth != null"
        },
        "ownerRequest": {
          ".write": "auth != null"
        },
        "pins": {
          ".write": "auth != null"
        },
        "placeEvents": {
          ".write": "auth != null"
        },
        "places": {
          ".write": "auth != null"
        },
        "voiceAll": {
          ".write": "auth != null"
        },
        "voicelog": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      }
    },
    "gltest": {
      ".read": "auth != null",
      "$group": {
        "users": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "glh": {
          ".read": "auth != null",
          "$room": {
            ".write": "auth != null && !newData.exists()",
            "$uid": {
              ".write": "auth != null"
            }
          }
        },
        "$other": {
          ".write": true
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "_forceReload": {
      ".read": true,
      ".write": "auth != null"
    },
    "_forceRestart": {
      ".read": true,
      ".write": "auth != null"
    },
    "_minNative": {
      ".read": true,
      ".write": "auth != null"
    },
    "glh": {
      ".read": "auth != null",
      "$room": {
        "$uid": {
          ".write": "auth != null"
        }
      }
    }
  }
}
