{
  "rules": {
    "gl": {
      // Admin panel. Firebase does not cascade read permission upward, so giving every child
      // its own rule left gl itself unreadable by ANYONE, the app owner included, and the admin
      // page -- which listens on gl to count groups, pins and messages -- sat on "Connecting to
      // Firebase" indefinitely. Grants the whole subtree to one uid. No other identity gains
      // anything, and every child rule below is unchanged.
      ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'",
      // A claimed device is a child's watch reporting live GPS. Read is now its owner and the
      // people it was shared with; an UNCLAIMED device stays readable so the claim flow can
      // still find it. The "live" subtree keeps an open write because the watch firmware posts
      // without an account -- narrowing that needs a firmware change and is tracked separately.
      // Everything carrying AUTHORITY is locked: owner (server.js trusts it for /wake-device),
      // sched, fcmToken, shareCode. Before this an UNAUTHENTICATED PUT to owner was accepted,
      // verified 2026-10-10, which handed over device-wake rights to anyone at all.
      "_devices": {
        "$id": {
          ".read": "auth != null && (!data.child('owner').exists() || data.child('owner').val() === auth.uid || data.child('sharedWith').child(auth.uid).exists() || root.child('gl').child('_deviceOwners').child(auth.uid).child($id).exists())",
          "live": {
            ".write": true
          },
          "owner": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)"
          },
          "sched": {
            ".write": "auth != null && data.parent().child('owner').val() === auth.uid"
          },
          "fcmToken": {
            ".write": "auth != null && (!data.parent().child('owner').exists() || data.parent().child('owner').val() === auth.uid)"
          },
          "shareCode": {
            ".write": "auth != null && data.parent().child('owner').val() === auth.uid"
          },
          ".write": "auth != null && (!data.child('owner').exists() || data.child('owner').val() === auth.uid)"
        }
      },
      "_deviceShares": {
        "$code": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_debug": {
        ".write": true,
        ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
      },
      "_diag": {
        "devices": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
      },
      "_activityLog": {
        "$day": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
      },
      "_deviceOwners": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_deviceSharedWithMe": {
        "$acct": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      // Maps a device id to the account signed in on it, and it is an AUTHORIZATION input --
      // users/$uid, config, _avatars and server.js roomAccess all read it, and the fixes above
      // now lean on it too. It accepted a write from any signed-in user for ANY uid, so one
      // forged entry impersonated another member: enough to seize a room's config, flip
      // circle to false, and undo today's read lock entirely. A device may now only claim
      // ITSELF, and only onto the account doing the claiming.
      "_devOwner": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (newData.child('acct').val() === auth.uid && (!data.child('acct').exists() || data.child('acct').val() === auth.uid)))",
          ".validate": "!newData.exists() || newData.child('acct').isString()"
        },
        ".read": "auth != null"
      },
      "_voipSubs": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": false
      },
      "_avatars": {
        "$acct": {
          ".write": "auth != null && (auth.uid === $acct || root.child('gl').child('_devOwner').child($acct).child('acct').val() === auth.uid)"
        },
        ".read": "auth != null"
      },
      "_pttSubs": {
        "$uid": {
          ".write": "auth != null"
        },
        ".read": false
      },
      "_aclMiss": {
        "$room": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
      },
      "_authMap": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        },
        ".read": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
      },
      "_roomIndex": {
        "$room": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      "_directory": {
        "$acct": {
          ".write": "auth != null && auth.uid === $acct"
        },
        ".read": "auth != null"
      },
      // The read was on the PARENT, so one request returned every pending invite in the
      // product -- each carrying the room's inviteKey and its plaintext pin. That key is the
      // only thing the acl self-add clause asks for, so this was a direct path into any crew,
      // and today's new room read-lock would then admit the attacker as a legitimate member.
      // Verified exploitable 2026-10-10. Read is now the recipient's own inbox only.
      "_invites": {
        "$acct": {
          ".read": "auth != null && (auth.uid === $acct || root.child('gl').child('_devOwner').child($acct).child('acct').val() === auth.uid)",
          ".write": "auth != null"
        }
      },
      "_presence": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid || root.child('gl').child('_authMap').child(auth.uid).child('glUid').val() === $uid)"
        },
        ".read": "auth != null"
      },
      "_sessions": {
        ".write": "auth != null && !newData.exists()",
        "$sid": {
          ".write": "auth != null"
        },
        ".read": "auth != null"
      },
      // Saved pins and tracks live here, which for most people means home and work. The parent
      // .read exposed every account's; the parent .write let any signed-in user overwrite
      // another account's profile, friends and pins. Cross-account people search already uses
      // _directory (name + device id only), which is deliberately minimal and stays readable.
      "_users": {
        "$acct": {
          // The _devOwner clause is gone from BOTH sides. A stranger can still create a missing
          // _devOwner entry naming themselves (verified 2026-10-11), and while that no longer
          // buys a room takeover, here it would have bought read AND write on somebody's
          // profile -- their saved pins, which for most people are home and work, and the
          // ability to empty their crews. auth.uid is the only identity here that cannot be
          // forged, so it is the only one this trusts. Nothing legitimate is lost: every
          // signed-in device now authenticates AS the account (see /authbridge), and a device
          // that is not signed in reads its own profile under its own id.
          ".read": "auth != null && auth.uid === $acct",
          ".write": "auth != null && auth.uid === $acct"
        }
      },
      "_deadRooms": {
        ".read": "auth != null",
        ".write": "false"
      },
      // Keep-alive verdicts (server.js WAKE OUTCOMES), written only through the admin SDK, which
      // these rules do not govern. Named here so the $room wildcard below cannot claim the node:
      // that rule reads anything without config/circle as a quick room, open to every signed-in
      // user, and lets one delete it. The gl .read above still covers the admin account.
      "_wake": {
        ".read": false,
        ".write": false
      },
      // Same reason for the other server-only nodes: without a named rule the $room wildcard
      // below lets a signed-in uid write gl/_authLog/<its own uid> -- a phone could erase its own
      // permission log. The admin SDK bypasses these rules; nothing the server does changes.
      "_authLog": { ".read": false, ".write": false },
      "_uptime":  { ".read": false, ".write": false },
      "_pruned":  { ".read": false, ".write": false },
      "$room": {
        ".write": "auth != null && !newData.exists() && (data.child('config').child('owner').val() === auth.uid || (!data.child('users').exists() && !data.child('members').exists() && !data.child('acl').exists() && !data.child('pins').exists() && !data.child('chat').exists() && !data.child('trails').exists()))",
        "users": {
          // Writing a users row is what puts a dot on a Crew's map. The rule only ever asked
          // "is this your own row", so ANY signed-in person who opened a Crew link or typed the
          // group name appeared on it, roster or not -- confirmed 2026-10-09 with a tester
          // reporting live into our_crew while absent from both its roster and its acl.
          //
          // For a CREW (config/circle === true) the acl is now required. The acl rule below
          // already lets an invited person add themselves with the room's inviteKey, so an
          // invite still works end to end; what no longer works is walking in without one.
          // Deletes stay open (!newData.exists()) so leaving and being removed still work, and
          // non-circle quick rooms are deliberately untouched -- joining those is the point.
          // Everyone already present was grandfathered into acl first, so this locks nobody out.
          // Access is checked against the SIGNED-IN ACCOUNT as well as the device id. A position
          // row is keyed by DEVICE, but people are added to a Crew by ACCOUNT -- so a member's
          // new phone had no acl entry of its own, could not write its dot, and the app read
          // that as "ask for permission to join" on a Crew the person OWNS. Reported
          // 2026-10-11 by the owner of our_crew, on a new handset. Checking auth.uid is safe:
          // it is the cryptographically verified account, not a client-written claim, and the
          // identity half of this rule has already established that this device belongs to it.
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid) && (!newData.exists() || !root.child('gl').child($room).child('config').child('owner').exists() || root.child('gl').child($room).child('acl').child($uid).exists() || root.child('gl').child($room).child('acl').child(auth.uid).exists() || root.child('gl').child($room).child('config').child('owner').val() === auth.uid)"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
          }
        },
        "acl": {
          "$uid": {
            ".write": "auth != null && (root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists() || (auth.uid === $uid && !newData.exists()) || (data.parent().child(auth.uid).exists() && newData.exists()) || (auth.uid === $uid && newData.child('ik').isString() && root.child('gl').child($room).child('config').child('inviteKey').isString() && newData.child('ik').val() === root.child('gl').child($room).child('config').child('inviteKey').val()))"
          }
        },
        "joinReq": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (auth.uid === $uid || root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists())"
          },
          ".read": "auth != null && (root.child('gl').child($room).child('config').child('owner').val() === auth.uid || root.child('gl').child($room).child('config').child('admins').child(auth.uid).exists())"
        },
        // Build 933 writes a record here whenever a device notices it was not running (or was
        // running and not reporting) for long enough to leave a hole in the crew's picture.
        // There was no rule for it until 941, so every one of those records was refused and the
        // node stayed empty -- the forensics looked like "no outages" when they were "no writes".
        "coverage": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "diag": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "favSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "history": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "pushSubs": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "trails": {
          ".write": "auth != null && !newData.exists()",
          "$uid": {
            ".write": "auth != null"
          }
        },
        "voice": {
          "$uid": {
            ".write": "auth != null"
          }
        },
        "chat": {
          ".write": "auth != null"
        },
        "closed": {
          ".write": "auth != null"
        },
        "config": {
          // The _devOwner clause is GONE. It read "whoever _devOwner says owns the owner's id
          // may rewrite this room", and _devOwner lets anyone create a MISSING entry for any
          // uid as long as they name themselves. Three rooms had owners with no entry --
          // mom_and_dad_trip, roberts_fam, testroom -- so a stranger could claim the owner,
          // pass this test, rewrite config and set circle:false, which turns off the read lock
          // and exposes the whole crew. Found 2026-10-11 while auditing for the same
          // device-versus-account mistake that broke two things earlier the same night.
          //
          // Nothing legitimate is lost: a device of the owner now signs the WebView in AS the
          // account (see /authbridge), so auth.uid IS the owner and the direct test passes.
          ".write": "auth != null && (!data.child('owner').exists() || data.child('owner').val() === auth.uid || data.child('admins').child(auth.uid).exists())",
          "invited": {
            "$uid": {
              ".write": "auth != null"
            }
          },
          "adminRequest": {
            "$uid": {
              ".write": "auth != null"
            }
          },
          "placeGuard": {
            "$k": {
              ".write": "auth != null"
            }
          },
          "removed": {
            "$uid": {
              ".write": "auth != null && !newData.exists()"
            }
          },
          "persistent": {
            ".write": "auth != null && newData.val() === true"
          },
          "circle": {
            ".write": "auth != null && newData.val() === true"
          },
          "visibility": {
            ".write": "auth != null && newData.val() === 'private'"
          },
          "expires": {
            ".write": "auth != null && !data.exists() && newData.isNumber() && !data.parent().child('persistent').exists()"
          },
          "inviteKey": {
            ".write": "auth != null && newData.isString() && newData.val().length >= 12 && (!data.exists() || data.parent().child('owner').val() === auth.uid || data.parent().child('admins').child(auth.uid).exists())"
          }
        },
        "debug": {
          ".write": "auth != null"
        },
        "ownerRequest": {
          ".write": "auth != null"
        },
        "pins": {
          ".write": "auth != null"
        },
        "placeEvents": {
          ".write": "auth != null"
        },
        "places": {
          ".write": "auth != null"
        },
        "voiceAll": {
          ".write": "auth != null"
        },
        "voicelog": {
          ".write": "auth != null"
        },
        // Reading a room is reading everyone's live position in it. This used to be open to any
        // signed-in user, so a Crew was protected only by nobody guessing its name -- and the
        // home screen search explicitly finds private rooms by name. Approving someone decided
        // who could APPEAR on the map, never who could WATCH it.
        //
        // A CREW (config/circle === true) is now readable only by its acl and its owner. Quick
        // non-circle rooms are untouched, because walking into one is the point of them.
        // 2026-10-30 (976): quick rooms too, at the owner's request -- anyone who knew a quick
        // room's name could read everyone's live position in it. Every room is now readable by
        // its acl and its owner only; an invite link still lets people in (acl self-add with the
        // room's inviteKey). The one exception is a room with no owner yet, i.e. one being
        // created this moment, so its creator can open it and claim it.
        // Account uids were added alongside device uids first, so a phone signed in with Google
        // matches; every active member was verified covered before this went live. Child rules
        // still grant on their own (joinReq/$uid stays readable by its requester), so asking to
        // join a room you cannot see continues to work.
        ".read": "auth != null && (!root.child('gl').child($room).child('config').child('owner').exists() || root.child('gl').child($room).child('acl').child(auth.uid).exists() || root.child('gl').child($room).child('config').child('owner').val() === auth.uid)"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "_forceReload": {
      ".read": true,
      ".write": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
    },
    "_forceRestart": {
      ".read": true,
      ".write": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
    },
    "_minNative": {
      ".read": true,
      ".write": "auth != null && auth.uid === '1RwPgdSdOEgp3lhlGly5I71EkY73'"
    },
    // Trail history. It lives OUTSIDE gl/ for write throughput, which also put it outside
    // every access rule gl/$room has -- one root ".read": "auth != null" handed every family's
    // day-by-day movement track to any signed-in account, including one created seconds
    // earlier. Verified exploitable 2026-10-10 before this change. Gated per room on the SAME
    // predicate as gl/$room so the two cannot drift apart again, and writes narrowed to the
    // person the trail belongs to -- it was "any signed-in user", so anyone could forge
    // anyone's history.
    "glh": {
      "$room": {
        ".read": "auth != null && (root.child('gl').child($room).child('acl').child(auth.uid).exists() || root.child('gl').child($room).child('config').child('owner').val() === auth.uid)",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('gl').child('_devOwner').child($uid).child('acct').val() === auth.uid)"
        }
      }
    }
  }
}
