# Copy this file to ".env" (same folder) and fill in your keys.
# The .env file stays on your PC and is never committed to git.

# Anthropic (console.anthropic.com) - drafts the minutes
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (platform.openai.com) - transcribes the audio
OPENAI_API_KEY=sk-...

# Optional overrides
# PORT=3100
# CLAUDE_MODEL=claude-opus-5
# WHISPER_MODEL=whisper-1
