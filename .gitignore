# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Capacitor / Android build artifacts (regenerable) ───────────
native-app/android/build/
native-app/android/app/build/
native-app/android/.gradle/
native-app/android/.idea/
native-app/android/captures/
native-app/android/local.properties
native-app/android/app/release/

# ── App / signing artifacts ─────────────────────────────────────
*.apk
# Whitelist the one APK we publish at /download (everything else stays ignored):
!public/GroundLink.apk
*.aab
*.keystore
*.jks
# groundlink.keystore = debug-grade key with the well-known public password 'android', used
# ONLY for local/sideload debug builds. Committing it is deliberate: it keeps the sideload
# signature stable so in-place updates and Google sign-in don't break. Nothing secret in it.
!native-app/android/app/groundlink.keystore
#
# groundlink-upload.keystore (the REAL Play Store upload key) is NOT whitelisted. It was
# committed 2026-07-18 with its password inline in app/build.gradle, in a public repo —
# treat that key as compromised and reset it via Play Console. Upload-key credentials now
# live in native-app/android/keystore.properties (below), never in tracked files.
native-app/android/keystore.properties
# Upload certificates are public certs, but keep them out of the tree to avoid confusion:
*.pem

# ── Logs / OS / editor cruft ────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
