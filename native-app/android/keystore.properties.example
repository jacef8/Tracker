# Copy to keystore.properties (which is gitignored) and fill in real values.
# keystore.properties holds the Play Store UPLOAD key credentials and must never be committed.
#
# The keystore file itself is also untracked (*.keystore). Keep a backup of it OFF this
# machine — if it is lost you must request another upload-key reset from Google.
uploadStoreFile=groundlink-upload.keystore
uploadStorePassword=CHANGE_ME
uploadKeyAlias=groundlink_upload
uploadKeyPassword=CHANGE_ME
