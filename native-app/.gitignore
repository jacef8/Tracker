# Capacitor / native build artifacts
node_modules/
# The generated Android project — commit it if you want it versioned, otherwise
# regenerate with `npx cap add android`. Uncomment the next line to ignore it.
# android/
.gradle/
*.keystore
*.jks
# groundlink.keystore is debug-grade (well-known password 'android') and stays committed on
# purpose so the sideload signature never changes.
!android/app/groundlink.keystore
# groundlink-upload.keystore (the real Play Store upload key) is NOT whitelisted — it was
# published in this public repo on 2026-07-18 and is being reset via Play Console. Upload-key
# credentials belong in android/keystore.properties, which is ignored.
android/keystore.properties
*.pem
local.properties
