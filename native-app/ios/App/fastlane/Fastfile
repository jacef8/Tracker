default_platform(:ios)

APP_IDENTIFIER = "com.groundlink.ios".freeze

platform :ios do
  desc "Build and upload a build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"], # base64-encoded .p8 contents
      is_key_content_base64: true,
      in_house: false
    )

    # Keeps TestFlight build numbers monotonically increasing without hand-editing the
    # Xcode project every release — mirrors the Android side's APP_BUILD discipline.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H")
    )

    # Fetch the App Store profile — creating or regenerating it as needed — instead of
    # decoding one that was captured into a secret months ago.
    #
    # A provisioning profile is a SNAPSHOT of the App ID's capabilities at generation time, so
    # the stored-profile approach broke the moment an entitlement was added: associated-domains
    # failed the build with "Provisioning profile doesn't include the Associated Domains
    # capability", fixable only by hand in the portal. The workflow step before this one turns
    # the capability on via the App Store Connect API; force: true then regenerates the profile
    # so it actually contains it. A future entitlement now needs no portal visit and no secret
    # rotation — add it to App.entitlements, name it in the workflow, done.
    # force: true on its own. Passing readonly: false alongside it is rejected outright with
    # "Error resolving conflict between options: 'readonly' and 'force'" — force already means
    # "regenerate", so readonly would be contradicting it rather than reinforcing it.
    sigh(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      force: true
    )

    # Point the Xcode project at the profile sigh just made.
    #
    # The project had PROVISIONING_PROFILE_SPECIFIER = "GroundLink App Store" baked into its
    # Release config, while sigh names what it creates "com.groundlink.ios AppStore". Archiving
    # resolves that specifier itself, long before export_options are consulted, so the build
    # died with "No profile for team 'XM3MLRA366' matching 'GroundLink App Store' found" even
    # though the correct profile was downloaded and installed moments earlier.
    #
    # Setting it from SIGH_NAME rather than hardcoding the new string keeps the two in step no
    # matter what fastlane decides to call the profile later. Release only — Debug builds are
    # left alone.
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: "XM3MLRA366",
      targets: ["App"],
      build_configurations: ["Release"],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          # Whatever sigh just installed, by name — no PROVISIONING_PROFILE_NAME secret that
          # can drift out of sync with the profile actually in use.
          APP_IDENTIFIER => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    # Upload AND hand it to the external testers. Uploading alone is not shipping.
    #
    # This lane used to stop at upload, and a build that is merely uploaded reaches nobody:
    # TestFlight distributes to GROUPS, and nothing here ever added the build to one. The result
    # was every build from v6 to v17 sitting in the internal group — which contains no real
    # testers — while all 13 external testers stayed on v5 from 16 July. Thirteen days of
    # feedback against stale code, and it looked like everything was working.
    #
    # skip_waiting_for_build_processing MUST be false here: fastlane rejects combining it with
    # distribute_external, and Apple cannot hand out a build it has not finished processing. It
    # makes the job longer (processing is usually 5-15 min) but the job then means what it says —
    # green equals "testers can install it", not "the bytes arrived somewhere".
    #
    # The group name is hardcoded on purpose. If it is ever renamed this fails loudly, which is
    # strictly better than the silent non-distribution it replaces.
    # Upload only. Distribution is the `distribute` lane below, deliberately separated.
    #
    # Combining them requires skip_waiting_for_build_processing: false, and fastlane's readiness
    # check disagreed with reality: it polled "Waiting for App Store Connect to finish
    # processing the new build (1.0 - 19)" every 30s for forty minutes while the App Store
    # Connect API simultaneously reported that same build as processingState=VALID. It would
    # have waited indefinitely. Splitting the steps means a stuck poll can never hold the build
    # hostage — the binary is uploaded and safe, and distribution can be retried on its own.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Distribute an ALREADY-UPLOADED build to the external testers"
  lane :distribute do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # distribute_only skips the upload entirely and acts on a build already in App Store
    # Connect, which is what makes this retryable without burning a build number.
    #
    # This is the step nothing has ever performed: TestFlight hands builds to GROUPS, and an
    # external group additionally requires Beta App Review. Without both, a build sits at
    # "Ready to Submit" and reaches no one — which is why 13 testers stayed on v5 from 16 July
    # while a dozen newer builds showed as "Complete" in App Store Connect.
    pilot(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_only: true,
      distribute_external: true,
      groups: ["Family Testers (External)"],
      build_number: ENV["DISTRIBUTE_BUILD"],   # optional; newest is used when unset
      changelog: ENV["CHANGELOG"] || "Bug fixes and improvements."
    )
  end
end
