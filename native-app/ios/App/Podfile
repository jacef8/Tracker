require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCommunityBackgroundGeolocation', :path => '../../node_modules/@capacitor-community/background-geolocation'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorFirebaseMessaging', :path => '../../node_modules/@capacitor-firebase/messaging'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorDevice', :path => '../../node_modules/@capacitor/device'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # Google sign-in for CapacitorFirebaseAuthentication — added DIRECTLY instead of via the
  # pod's :subspecs => ['Google'] mechanism. The subspec route produced a pod that installed
  # and passed the lockfile guard yet yielded no importable module and no runtime plugin
  # class (confirmed both ways 2026-07-30: `import CapacitorFirebaseAuthentication` failed to
  # resolve in CI, and a tester's v25 runtime plugin fingerprint was missing
  # FirebaseAuthentication entirely — both sign-in buttons dead). Plain pod + explicit
  # GoogleSignIn + the RGCFA_INCLUDE_GOOGLE flag below is the equivalent, working setup.
  # This line survives `cap sync` (which only rewrites the capacitor_pods def above).
  pod 'GoogleSignIn', '7.1.0'
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # The other half of the subspec replacement: compile the plugin's Google provider code in.
  # Without this flag the plugin builds its Lite variant and signInWithGoogle() is a no-op.
  # The Lite pod doesn't declare GoogleSignIn as a dependency, so the flag alone leaves the
  # handler's `import GoogleSignIn` unresolvable ("unable to resolve module dependency",
  # first attempt 2026-07-30) — the plugin target also needs GoogleSignIn's build products
  # on its search paths and a build-order dependency so they exist before it compiles.
  installer.pods_project.targets.each do |t|
    next unless t.name == 'CapacitorFirebaseAuthentication'
    gs = installer.pods_project.targets.find { |x| x.name == 'GoogleSignIn' }
    t.add_dependency(gs) if gs
    t.build_configurations.each do |config|
      config.build_settings['OTHER_SWIFT_FLAGS'] = '$(inherited) -DRGCFA_INCLUDE_GOOGLE'
      paths = Array(config.build_settings['FRAMEWORK_SEARCH_PATHS'] || '$(inherited)')
      paths << '${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn'
      paths << '${PODS_CONFIGURATION_BUILD_DIR}/AppAuth'
      paths << '${PODS_CONFIGURATION_BUILD_DIR}/GTMAppAuth'
      paths << '${PODS_CONFIGURATION_BUILD_DIR}/GTMSessionFetcher'
      paths << '${PODS_CONFIGURATION_BUILD_DIR}/AppCheckCore'
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = paths.uniq
    end
  end
end
