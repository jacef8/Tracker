<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without this key iOS never calls
	     registerForRemoteNotifications, so the Firebase Messaging plugin can't get an APNs
	     token and no FCM token is ever minted — which is why every iPhone had zero push
	     subscriptions while Android worked. Value is the APNs environment: "development" for
	     debug/simulator builds, "production" for TestFlight and App Store builds — it must match
	     the build's provisioning profile, and a distribution (App Store) build requires "production". -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links. Pairs with the apple-app-site-association file served by server.js;
	     BOTH halves are required, and neither does anything alone. Without this entitlement a
	     texted /j/<room> invite always opened in Safari even with the app installed. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tracker-production-3b03.up.railway.app</string>
	</array>
	<!-- Push to Talk (iOS 16+). The purpose-built walkie-talkie framework: transmissions play
	     through the speaker with a small system indicator and NO CallKit call screen / ring. This
	     entitlement must be enabled on the App ID (see the workflow's asc-enable-capabilities step)
	     and requires the PushToTalk framework code in AppDelegate, gated on @available(iOS 16). -->
	<key>com.apple.developer.push-to-talk</key>
	<true/>
</dict>
</plist>
